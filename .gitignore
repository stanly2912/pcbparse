# Git stores active application, training/data tooling and build metadata.
# Dataset/model assets, evaluation, tests and experiments remain in the workspace.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.github/
!/README.md
!/pyproject.toml
!/requirements.lock
!/requirements.runtime.lock
!/requirements.edarace.txt
!/requirements-yolo.txt
!/src/
!/data_tools/
!/configs/
!/models/
!/docker/

# Evaluation is an offline workspace companion.
/src/pcbparse/evaluation/

# Production/training configurations, without experiment sweeps.
/configs/*
!/configs/models.yaml
!/configs/official_schema.yaml
!/configs/pipeline.yaml
!/configs/pipeline.edarace.yaml
!/configs/thresholds.yaml
!/configs/profiles/
!/configs/train/
/configs/profiles/*
!/configs/profiles/baseline.yaml
!/configs/profiles/competition.yaml
/configs/train/opt*.json

# Physical model bundles remain on the server.
/models/*
!/models/models.lock.json
!/models/registry.yaml

/docker/*
!/docker/Dockerfile
!/docker/Dockerfile.cpu
!/docker/agent_system
!/docker/verify_wheelhouse.py

/data_tools/*
!/data_tools/*.py

# Caches, credentials and generated binaries.
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*
*.pem
*.key
*.pt
*.pth
*.onnx
*.ts
Thumbs.db
Desktop.ini
.DS_Store
